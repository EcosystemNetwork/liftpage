# Server only. Never put these in client code or commit .env.local.

# HarnessRouter Cloud. Community Edition uses http://localhost:3000/api/harness
HARNESSROUTER_BASE_URL=https://api.harnessrouter.ai
HARNESSROUTER_API_KEY=
HARNESSROUTER_HARNESS_ID=codex
HARNESSROUTER_MODEL=gpt-5.4-mini

# PaleBlueDot TokenRouter, optional. OpenAI-compatible chat completions.
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=openai/gpt-5-mini

# Accounts. The first admin is created from these on first start, once.
# Change the password after signing in; the env value is only used while no admin exists.
LIFTPAGE_ADMIN_EMAIL=
LIFTPAGE_ADMIN_PASSWORD=
# Signs session cookies. Required in production, 32+ characters: openssl rand -base64 48
# In development a random one is kept in data/session-secret.
LIFTPAGE_SESSION_SECRET=
# "false" closes self sign-up; admins still make client accounts under /admin/users.
LIFTPAGE_OPEN_SIGNUP=true
