# Server only. Never put these in client code or commit .env.local.

# HarnessRouter Cloud. Community Edition uses http://localhost:3000/api/harness
HARNESSROUTER_BASE_URL=https://api.harnessrouter.ai
HARNESSROUTER_API_KEY=
HARNESSROUTER_HARNESS_ID=codex
HARNESSROUTER_MODEL=gpt-5.4-mini
# Content studio (/account/studio) runs the content agent on HarnessRouter Cloud. Its Harness is
# fixed in code (lib/studio.ts, copy in harnessrouter.json) and it uses HARNESSROUTER_API_KEY above;
# set HR_API_KEY instead to give it a key of its own. Any key of the Harness's workspace works.
HR_API_KEY=
# Signs short-lived links that preview generated HTML. Optional: derived from SUPABASE_SECRET_KEY if empty.
STUDIO_PREVIEW_SECRET=

# PaleBlueDot TokenRouter, optional. OpenAI-compatible chat completions.
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=openai/gpt-5-mini

# Public origin, for links in emails and OAuth redirect URIs. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3070

# Supabase: Postgres, Auth, Storage. Run supabase/migrations/*.sql on the project first.
# Project Settings > API. The publishable key is browser-safe; the secret key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Accounts. Admin is locked to the owner emails in lib/owner.ts (EricNans@gmail.com). On start,
# the owner account is made (or its password set) from LIFTPAGE_ADMIN_PASSWORD while it isn't
# an admin yet. LIFTPAGE_ADMIN_EMAIL only picks which owner email, and is ignored otherwise.
LIFTPAGE_ADMIN_EMAIL=ericnans@gmail.com
LIFTPAGE_ADMIN_PASSWORD=
# "false" closes self sign-up; admins still make client accounts under /admin/users.
LIFTPAGE_OPEN_SIGNUP=true

# Resend. Request confirmations, invites, password resets, receipts.
# Without it, admins get one-time links to pass on and Supabase sends its own reset email.
RESEND_API_KEY=
EMAIL_FROM="LiftPage <hello@your-domain.com>"
# Where new-request and payment notices go. Defaults to LIFTPAGE_ADMIN_EMAIL.
LIFTPAGE_NOTIFY_EMAIL=
# "true" emails every client a performance report on Monday mornings (Pacific).
# Off by default; Admin > Tools can send reports by hand either way.
LIFTPAGE_WEEKLY_REPORTS=

# Inngest. Publishes cued posts at their slot, sends request emails, syncs insights daily.
# Local: npx inngest-cli@latest dev -u http://localhost:3070/api/inngest and set INNGEST_DEV=1.
# Cloud: set the two keys and sync <site>/api/inngest in the Inngest dashboard.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Social publishing. Seals network tokens at rest: openssl rand -base64 32
LIFTPAGE_TOKEN_KEY=
# Register <site>/api/social/<platform>/callback as the redirect URI in each developer console.
# X: developer.x.com, OAuth 2.0, confidential client. Scopes tweet.read tweet.write users.read offline.access.
X_CLIENT_ID=
X_CLIENT_SECRET=
# LinkedIn: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect" products.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610
# "true" posts as the company page the member administers and pulls page insights.
# Needs LinkedIn's Community Management API product.
LINKEDIN_ORGANIZATION_PAGES=false
# Instagram API with Instagram Login (Meta app). Business or creator accounts only.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Google Cloud: YouTube Data API v3 + YouTube Analytics API, OAuth web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# public | unlisted | private. Unaudited Google projects are forced to private.
YOUTUBE_PRIVACY=public
# TikTok for Developers: Login Kit + Content Posting API (Direct Post).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unaudited TikTok apps may only post SELF_ONLY.
TIKTOK_PRIVACY=SELF_ONLY

# Payments, email, observability
# Stripe. Checkout prices from the request row; the webhook marks it won when paid.
# Webhook endpoint: <site>/api/stripe/webhook, events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_failed.
# Local: stripe listen --forward-to localhost:3070/api/stripe/webhook
# The "Manage billing" button needs a customer portal configuration (Dashboard → Settings →
# Billing → Customer portal, save once per mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Publishable key. Unused today (Checkout is hosted); here for Stripe.js if that changes.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Tax: "on" adds tax at checkout and on invoices. Turn on only after adding a
# head-office address and a tax registration in Dashboard → Settings → Tax.
STRIPE_TAX=
# Sentry. Each part is optional: no DSN, no reporting; no auth token, no source map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# PostHog. Pageviews and server events (payments). No replay, text masked.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
